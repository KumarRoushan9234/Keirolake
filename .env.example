# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------- LLMs (answer generation, text-to-SQL) ----------
# Providers are tried in this order; inside a provider, models are tried in order.
# Supported names: openrouter, groqcloud, deepseek, gemini, anthropic, openai, mistral, together, ollama
LLM_FALLBACK_ORDER="openrouter,groqcloud"

OPENROUTER_API_KEY=
OPENROUTER_MODELS="qwen/qwen3.7-flash,inclusionai/ling-3.0-flash,inclusionai/ling-3.1-flash"

GROQCLOUD_API_KEY=
GROQCLOUD_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"

DEEPSEEK_API_KEY=
DEEPSEEK_MODELS="deepseek-chat"          # native DeepSeek ids, not OpenRouter slugs

GEMINI_API_KEY=
GEMINI_MODELS="gemini-2.5-flash"

ANTHROPIC_API_KEY=
ANTHROPIC_MODELS="claude-sonnet-5-5"

OPENAI_API_KEY=
OPENAI_MODELS=

OLLAMA_BASE_URL=http://localhost:11434   # inside compose this becomes http://ollama:11434
OLLAMA_MODELS=                           # e.g. llama3.1

# ---------- KeiroLabs (web search / extract) ----------
KEIROLABS_SEARCH_LITE_API_KEY=
KEIROLABS_API_KEY=                       # optional; takes precedence if set

# ---------- Embeddings (open-source models served through OpenRouter) ----------
# provider is optional (defaults to openrouter), format: [provider:]model:dimension
# The first model that works is used; each model gets its own Qdrant named vector.
EMBED_MODELS="baai/bge-m3:1024,qwen/qwen3-embedding-8b:1024"
# Optional Gemini embeddings (not open source). VIA = openrouter | native
EMBED_GEMINI_ENABLED=false
EMBED_GEMINI_MODEL=gemini-embedding-001
EMBED_GEMINI_DIM=768
EMBED_GEMINI_VIA=openrouter
EMBED_GEMINI_POSITION=last               # first | last in the chain
EMBED_DUAL_WRITE=false                   # also store the backup model's vector at ingest
EMBED_BATCH_SIZE=64

# ---------- Infra / RAG ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
RAG_TOP_K=8
RAG_WEB_FALLBACK=true
RAG_WEB_THRESHOLD=0.45
MAX_UPLOAD_MB=100

# ---------- Host ports for docker compose (bound to 127.0.0.1 only) ----------
WEB_PORT=3000
API_PORT=8000
QDRANT_PORT=6333
