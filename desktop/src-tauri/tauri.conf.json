{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeiroLake",
  "version": "0.9.0",
  "identifier": "app.keirolake.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeiroLake",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; frame-src http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Offline-first knowledge lake",
    "longDescription": "Your own data lake, offline Wikipedia and libraries, local or cloud AI, and KeiroLabs web collection.",
    "linux": {
      "deb": {},
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "KeiroLake",
        "template": "windows/installer.nsi",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "copyright": "© 2026 KeiroLabs · KeiroLake · MIT licensed"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCRjdBQjE5RjY4MUFERTMKUldUanJZSDJHYXYzQ3p0RThNUU1BSFVYTlluVi85RkFFRWFaWkdpOEphTEVaWllEVmg4MkNIOEcK",
      "endpoints": [
        "https://github.com/KumarRoushan9234/Keirolake/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
