{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app window: engine connection, live web window, folder picker",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-engine-info",
    "allow-open-web",
    "allow-capture-web",
    "allow-pick-folder",
    "allow-open-data-folder",
    "allow-open-in-browser",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-window-theme",
    "allow-update-check",
    "allow-update-install",
    "allow-relaunch"
  ]
}